# Configuracao de Exemplo - Barber Man (seguro para versionar no Git)

# Banco de Dados
DB_NAME=barber_man_db
DB_USER=barber_man_admin
DB_PASSWORD=sua_senha_segura_aqui
DB_PORT=5432

# Gateway Web / Proxy Reverso (Nginx com SSL e Rate Limiting)
HTTP_PORT=80
HTTPS_PORT=443

# Backend API (Spring Boot)
API_PORT=8081

# Gerenciamento de Containers (Portainer Web UI via HTTPS)
PORTAINER_PORT=9443

# Notificacoes WhatsApp (Evolution API - Gratuito via Docker)
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=http://evolution_api:8080
WHATSAPP_API_KEY=barberman_secret_key_123
WHATSAPP_INSTANCE=barber_man
WHATSAPP_SENDER_PHONE=+5531999999999
WHATSAPP_NOTIFY_OWNER=true
EVOLUTION_PORT=8080
